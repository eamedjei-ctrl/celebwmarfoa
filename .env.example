PORT=4321
# Required to upload/delete from /upload
ADMIN_KEY=change-me

# Leave S3_* empty to use the local ./bucket folder.
# Cloudflare R2:   S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com  S3_REGION=auto
# Supabase:        S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3  S3_REGION=<region>
# AWS S3:          leave S3_ENDPOINT empty, set S3_REGION=us-east-1 etc.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
